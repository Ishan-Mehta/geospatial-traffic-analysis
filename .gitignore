# ===========================
# Environment & Credentials
# ===========================
.env
*.env

# ===========================
# Raw Data (too large for git)
# ===========================
data/raw/*.json
data/raw/*.csv
!data/raw/.gitkeep
data/raw/gmaps_data/

# OSMnx HTTP cache (large, re-downloadable)
src/analysis/cache/

# v2 mock outputs (offline pipeline tests; regenerate with --mock)
data/benchmark_v2/mock/

# ===========================
# Generated Outputs
# ===========================
output/
!output/.gitkeep
*.gpkg
*.graphml

# Analysis results (reproducible)
results/
results_v0/

# Pipeline intermediate files
flattened_traffic_data.csv
master_subroutes.csv

# ===========================
# Large Documents
# ===========================
# Keep flowchart.pdf but exclude large reports
*Midsem Report*
*midsem*

# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
*_venv/
env/

# ===========================
# OS & IDE
# ===========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================
# Archives
# ===========================
*.zip

